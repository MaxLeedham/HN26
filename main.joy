2 setautoput . # CHANGE TO `0 setautoput .` BEFORE THE END

"board.joy" include .

# Seed rand with the current time
time srand .

# random() -> 0-3
DEFINE random == rand 4 rem.

# reset() -> empties the stack
DEFINE reset == [] unstack .

# rollup : X Y Z -> Y Z X
# rolldown : X Y Z -> Z X Y

# insert(position, value, list) -> list
DEFINE insert == rolldown dup rolldown dup swapd 1 + drop rolldownd cons rollup take swap concat .

DEFINE dip2 == [dip] cons dip .

# index(indx, array) -> element, array
DEFINE index == dupd drop first .

# dipn(n, [code...], rest_of_stack) -> modified rest of stack
DEFINE dipn == [[dip] cons] dip 1 - dup 0 = [pop i] [dipn] branch .

createboard.

dup random at.

2 random insert .

# check wasd and repeat if invalid.
stdin fgetch swap pop
["wasd" in not] [pop stdin fgetch swap pop] while.
